# Copy to .env and fill in. Never commit .env.
# Only the providers you actually use need a key. LiteLLM reads these names.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
NVIDIA_NIM_API_KEY=
XAI_API_KEY=
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=2024-10-21
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1

# Needed for gated open-weight models (Gemma 4, Llama 3.2)
HF_TOKEN=

# Where activations and generations are cached (large)
HALLUSCOPE_CACHE_DIR=cache
